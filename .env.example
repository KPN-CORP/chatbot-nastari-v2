APP_NAME=Nastari
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# `daily` rotates after LOG_DAILY_DAYS. That is fine for debugging, but do not
# treat the files as the analytics source: activity is written to
# nastari_events by NastariActivityLogger instead.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# ---------------------------------------------------------------------------
# Application database (this app's own tables). Migrations target this one.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Corporate HR database (read-only). Employee, Company and Location live here.
# There are no migrations for it: never migrate or seed this connection.
# ---------------------------------------------------------------------------
KPNCORP_DB_HOST=
KPNCORP_DB_PORT=3306
KPNCORP_DB_DATABASE=
KPNCORP_DB_USERNAME=
KPNCORP_DB_PASSWORD=

# State lives in the cache store with a 24h TTL, so clearing the cache drops
# every in-flight WhatsApp conversation. Prefer `route:clear`/`config:clear`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0

# ---------------------------------------------------------------------------
# Darwinbox HR API. Each API family has its own key; see
# DarwinboxService::getApiKey().
# ---------------------------------------------------------------------------
DARWINBOX_AUTH_TOKEN=
DARWINBOX_DATASET_KEY=
DARWINBOX_API_KEY_EMPLOYEE=
DARWINBOX_API_KEY_ATTENDANCE=
DARWINBOX_API_KEY_LEAVE_BALANCE=
DARWINBOX_API_KEY_DEPENDENT=
DARWINBOX_API_KEY_OVERTIME=
DARWINBOX_API_KEY_WEEKLYOFF=
DARWINBOX_API_KEY_HOLIDAYLIST=
DARWINBOX_API_KEY_LEAVE_TRANSACTIONS=
DARWINBOX_API_KEY_UPDATE_LEAVE=

# ---------------------------------------------------------------------------
# Gemini (Ruang, Nastari AI, weekly chat analysis).
#
# GEMINI_API_KEY is the one that resolves through
# config('services.gemini.api_key'). GEMINI_KEY only exists because
# config('services.gemini.key') was wired to it; the two birthday/anniversary
# helpers in DarwinboxService are its only consumers.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Nastari specifics (config/nastari.php)
# ---------------------------------------------------------------------------

# Set to false to stop writing activity events to nastari_events.
NASTARI_ACTIVITY_LOG=true

# Outbound HTTP defaults, applied globally in AppServiceProvider. Laravel's own
# default is 30s with no retry, which held WhatsApp webhook requests open once
# per slow call.
NASTARI_HTTP_TIMEOUT=20
NASTARI_HTTP_CONNECT_TIMEOUT=5
NASTARI_HTTP_SLOW_MS=5000

# Where NastariLogScanner looks for laravel*.log. Defaults to storage/logs;
# only set this if the log directory lives elsewhere. ERROR-level entries are
# copied into nastari_log_entries so they survive the 14-day rotation and show
# up on the dashboard. Credentials, phone numbers and email addresses are
# redacted before anything is stored.
NASTARI_LOG_PATH=

# Shared token for GET /tasks/employee-sync, the HTTP fallback for the daily
# employee sync where cron does not run `schedule:run`. Leave empty to disable
# the route entirely (it then returns 404).
TASK_RUNNER_TOKEN=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Note: Pandu escalation email does not use these. HearService talks to SMTP
# directly through PHPMailer with settings hardcoded in the class.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
